<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_parked"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="P"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_navigate_bg" />

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="Car parked here"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_clear_parking"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_clear_parking_description"
            android:padding="2dp"
            android:scaleType="center"
            android:src="@drawable/widget_close_icon"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_privacy_badge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/widget_privacy_icon"
            android:contentDescription="@string/widget_privacy_map_hidden_description"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_map_placeholder"
        android:background="@drawable/widget_map_placeholder"
        android:contentDescription="@string/widget_parked_map_description"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tv_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:text="Complete a drive to\nsave your parking spot"
        android:textColor="#FF78AACC"
        android:textSize="10sp"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_parked_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textColor="#FFAABBD0"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_parked_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FF78AACC"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_navigate"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:text="Navigate to car"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:background="@drawable/btn_navigate_bg"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />
</LinearLayout>
