<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/roadsage_primary</item>
        <item name="colorPrimaryDark">@color/roadsage_primary_dark</item>
        <item name="colorAccent">@color/roadsage_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/roadsage_primary</item>
        <item name="colorPrimaryDark">@color/roadsage_primary_dark</item>
        <item name="colorAccent">@color/roadsage_accent</item>
        <item name="android:colorAccent">@color/roadsage_accent</item>
        <item name="android:background">@color/roadsage_native_surface</item>
        <item name="android:colorBackground">@color/roadsage_native_surface</item>
        <item name="android:navigationBarColor">@color/roadsage_primary_dark</item>
        <item name="android:statusBarColor">@color/roadsage_primary_dark</item>
        <item name="android:windowBackground">@color/roadsage_primary_dark</item>
        <item name="android:textColorPrimary">@color/roadsage_native_text_primary</item>
        <item name="android:textColorSecondary">@color/roadsage_native_text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="android:actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="popupTheme">@style/AppTheme.Popup</item>
        <item name="android:popupTheme">@style/AppTheme.Popup</item>
    </style>

    <style name="AppTheme.AlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/roadsage_accent</item>
        <item name="android:colorAccent">@color/roadsage_accent</item>
        <item name="android:background">@color/roadsage_native_surface</item>
        <item name="android:colorBackground">@color/roadsage_native_surface</item>
        <item name="android:windowBackground">@color/roadsage_native_surface</item>
        <item name="android:textColorPrimary">@color/roadsage_native_text_primary</item>
        <item name="android:textColorSecondary">@color/roadsage_native_text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.ActionMode" parent="@style/Widget.AppCompat.ActionMode">
        <item name="background">@color/roadsage_native_surface</item>
        <item name="android:background">@color/roadsage_native_surface</item>
        <item name="android:textColorPrimary">@color/roadsage_native_text_primary</item>
        <item name="android:textColorSecondary">@color/roadsage_native_text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.Popup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@color/roadsage_native_surface</item>
        <item name="android:colorBackground">@color/roadsage_native_surface</item>
        <item name="android:textColorPrimary">@color/roadsage_native_text_primary</item>
        <item name="android:textColorSecondary">@color/roadsage_native_text_secondary</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
