<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Global default: HTTPS only, trust only system public root CAs.
        This applies to all domains not listed below.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <!-- Do not add user-installed CAs in release builds; they allow TLS interception. -->
        </trust-anchors>
    </base-config>

    <!--
        Known third-party services Road Sage contacts.
        Listed explicitly so external domains remain deliberate code/config changes.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openstreetmap.org</domain>
        <domain includeSubdomains="true">openstreetmap.de</domain>
        <domain includeSubdomains="true">openstreetmap.fr</domain>
        <domain includeSubdomains="true">openstreetmap.ru</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
        <domain includeSubdomains="true">overpass-api.de</domain>
        <domain includeSubdomains="true">overpass.kumi.systems</domain>
    </domain-config>

    <!--
        Optional backend (VITE_API_URL). Only active when the user configures one.
        If the backend domain is known at build time, add certificate pinning here:

        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="true">api.yourdomain.com</domain>
            <pin-set expiration="2027-01-01">
                <pin digest="SHA-256">CURRENT_LEAF_OR_INTERMEDIATE_SPKI_HASH=</pin>
                <pin digest="SHA-256">BACKUP_PIN_SPKI_HASH=</pin>
            </pin-set>
        </domain-config>

        Generate the pin with:
        openssl s_client -connect api.yourdomain.com:443 |
          openssl x509 -pubkey -noout |
          openssl pkey -pubin -outform DER |
          openssl dgst -sha256 -binary | base64
    -->

    <!--
        Development only: allow cleartext to localhost in a debug/res/xml override if needed.

        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">localhost</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
        </domain-config>
    -->

</network-security-config>
