    <!--
        Optional backend (VITE_API_URL) and user-configured OSRM endpoints are only
        active when configured by the user/build. If a domain is known at build time,
        add certificate pinning here:

        <domain-config cleartextTrafficPermitted="false">
            <domain includeSubdomains="true">api.yourdomain.com</domain>
            <pin-set expiration="2027-01-01">
                <pin digest="SHA-256">CURRENT_LEAF_OR_INTERMEDIATE_SPKI_HASH=</pin>
                <pin digest="SHA-256">BACKUP_PIN_SPKI_HASH=</pin>
            </pin-set>
        </domain-config>

        Generate the pin with:
        openssl s_client -connect api.yourdomain.com:443 |
          openssl x509 -pubkey -noout |
          openssl pkey -pubin -outform DER |
          openssl dgst -sha256 -binary | base64
    -->

    <!--
        Development only: allow cleartext to localhost in a debug/res/xml override if needed.

        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">localhost</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
        </domain-config>
    -->

</network-security-config>
