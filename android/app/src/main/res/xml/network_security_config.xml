<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!--
        Global default: HTTPS only, trust only system public root CAs.
        This applies to all domains not listed below.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <!-- Do not add user-installed CAs in release builds; they allow TLS interception. -->
        </trust-anchors>
    </base-config>

    <!--
        Certificate pins for every built-in third-party host Road Sage contacts.

        Pin = base64(SHA-256(SubjectPublicKeyInfo DER))

        Generate with:
        openssl s_client -connect HOST:443 -servername HOST -showcerts |
          openssl x509 -pubkey -noout |
          openssl pkey -pubin -outform DER |
          openssl dgst -sha256 -binary | base64

        Each pin-set includes the current leaf SPKI and a backup CA intermediate
        SPKI from the live chain. Review before expiration or certificate rotation.
    -->

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">nominatim.openstreetmap.org</domain>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">oZJBfE9OEiEGYsm+as/64F9KX39R5C8uOcOAmUWNO4U=</pin>
            <pin digest="SHA-256">AlSQhgtJirc8ahLyekmtX+Iw+v46yPYRLJt9Cq1GlB0=</pin>
        </pin-set>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">wpZbgMIpa8SFKTpX9je5pgZ7knTqu/bUoig6Dt/Sj14=</pin>
            <pin digest="SHA-256">biIcgxJw7HM1TbdJxioNUtXUL4DAGP3v1bLiXlQJxHw=</pin>
        </pin-set>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tile.openstreetmap.fr</domain>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">WZsOEdrZB7SfASvdoyvNp9A91KPMLyfDOwYFGwCSbUo=</pin>
            <pin digest="SHA-256">kZwN96eHtZftBWrOZUsd6cA4es80n3NzSk/XtYz2EqQ=</pin>
        </pin-set>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.open-meteo.com</domain>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">YAFPPxCwfYpnCvumZr5iRwQxdLb9dak90Qvb33ma0Fo=</pin>
            <pin digest="SHA-256">kZwN96eHtZftBWrOZUsd6cA4es80n3NzSk/XtYz2EqQ=</pin>
        </pin-set>
