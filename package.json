{
  "name": "drivesense-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run scoring:version && npm run docs:state",
    "build": "vite build --configLoader runner",
    "pretest": "npm run scoring:version:check && npm run docs:state:check",
    "test": "vitest run",
    "test:android:settings": "node tests/android-uiautomator-settings-full.mjs",
    "scoring:version": "node scripts/generate-scoring-version.mjs",
    "scoring:version:check": "node scripts/generate-scoring-version.mjs --check",
    "build:version": "npm run scoring:version",
    "docs:state": "node scripts/generate-app-state-docs.mjs",
    "docs:state:check": "node scripts/generate-app-state-docs.mjs --check",
    "test:contracts:live": "node scripts/run-live-contracts.mjs",
    "test:e2e": "npm run build && node ./node_modules/playwright/cli.js test",
    "postinstall": "node scripts/patch-android-gradle.mjs",
    "check:repo-hygiene": "node scripts/check-repository-hygiene.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./tsconfig.json",
    "calibration:fit": "node scripts/fit-calibration-labels.mjs",
    "calibration:promote": "node scripts/fit-calibration-labels.mjs --promote",
    "calibration:validate": "node scripts/fit-calibration-labels.mjs --validate",
    "calibration:dry-run": "node scripts/fit-calibration-labels.mjs --dry-run",
    "calibration:check-promotion-blockers": "node scripts/check-promotion-blocker-jsdoc.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-android-gradle.mjs",
    "android:open": "npx cap open android"
  },
