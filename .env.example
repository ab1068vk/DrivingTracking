# Optional backend API base URL. Leave blank for local-first storage.
# Must be an HTTPS public domain. If VITE_TRUSTED_BACKEND_ORIGINS is set,
# the API URL origin must be listed there.
VITE_API_URL=
VITE_TRUSTED_BACKEND_ORIGINS=

# IndexedDB database name for local trip storage. Keep the default for the
# production app; use a different name for staging or rebranded builds that
# must coexist on the same device.
VITE_DB_NAME=drivesense_mobile

# Absolute last fallback for map views on fresh installs with no trip route,
# no saved map center, no parked/home context, and no location permission.
# Set these for the deployment region; Toronto is used for the default build.
VITE_DEFAULT_MAP_LAT=43.6532
VITE_DEFAULT_MAP_LNG=-79.3832

# Optional self-hosted OSRM endpoint for deployments that operate their own
# routing server. Leave blank for consumer/local builds. Do not set this to the
# public OSRM demo server. Must be an HTTPS public domain that passes the
# OSRM OPTIONS health check. If VITE_TRUSTED_OSRM_ORIGINS is set, user-saved
# OSRM endpoint origins must be listed there.
VITE_DEFAULT_OSRM_URL=
VITE_TRUSTED_OSRM_ORIGINS=

# OSRM map-matching request timeout in milliseconds. Settings can override this
# per user with a 5-30 second Network timeout slider.
VITE_OSRM_TIMEOUT_MS=12000
